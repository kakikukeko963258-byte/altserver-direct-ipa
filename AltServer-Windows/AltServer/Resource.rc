ID_LOGIN DIALOGEX 0, 0, 268, 112
STYLE DS_SETFONT | DS_MODALFRAME | DS_SETFOREGROUND | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Please enter your Apple ID and password."
FONT 8, "MS Shell Dlg", 400, 0, 0x0
BEGIN
    PUSHBUTTON      "Cancel",IDCANCEL,155,91,50,14
    LTEXT           "Your Apple ID and password are not saved and are only sent to Apple for authentication.\n\nDue to some server changes, app-specific passwords will no longer work. Please use your normal password instead.",IDC_DESCRIPTION,7,7,254,43
    EDITTEXT        IDC_EDIT1,7,55,254,12,ES_AUTOHSCROLL
    EDITTEXT        IDC_EDIT2,7,69,254,12,ES_PASSWORD | ES_AUTOHSCROLL
    PUSHBUTTON      "Install",IDOK,211,91,50,14
END

ID_TWOFACTOR DIALOGEX 0, 0, 268, 64
STYLE DS_SETFONT | DS_MODALFRAME | DS_SETFOREGROUND | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Two-Factor Authentication Enabled"
FONT 8, "MS Shell Dlg", 400, 0, 0x0
BEGIN
    PUSHBUTTON      "Cancel",IDCANCEL,155,42,50,14
    EDITTEXT        IDC_EDIT1,7,22,254,12,ES_AUTOHSCROLL
    PUSHBUTTON      "Submit",IDOK,211,42,50,14
    LTEXT           "Please enter the 6-digit verification code that was sent to your Apple devices.",IDC_DESCRIPTION,7,7,254,11
END

ID_ICLOUD_MISSING_64 DIALOGEX 0, 0, 268, 94
STYLE DS_SETFONT | DS_MODALFRAME | DS_SETFOREGROUND | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "iCloud Not Found"
FONT 8, "MS Shell Dlg", 400, 0, 0x0
BEGIN
    PUSHBUTTON      "Cancel",IDCANCEL,84,73,50,14
    PUSHBUTTON      "Choose Folder...",ID_FOLDER,141,73,64,14
